  fluid
  style={{ </span><span><span class="hljs-attr">maxWidth</span></span><span>: </span><span><span class="hljs-string">'100%'</span></span><span>, </span><span><span class="hljs-attr">height</span></span><span>: </span><span><span class="hljs-string">'auto'</span></span><span>, </span><span><span class="hljs-attr">objectFit</span></span><span>: </span><span><span class="hljs-string">'contain'</span></span><span> }}
  onError={</span><span><span class="hljs-function">(<span class="hljs-params">e</span></span></span><span>) =&gt; {
    e.</span><span><span class="hljs-property">target</span></span><span>.</span><span><span class="hljs-property">onerror</span></span><span> = </span><span><span class="hljs-literal">null</span></span><span>; 
